{
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx"],
  // The desktop host runs under Deno, against Deno's own libs, and is checked
  // by `deno check` in that app's own task. Type-checking it here would only
  // report that `Deno` is not a name this project knows.
  "exclude": ["apps/desktop/main.ts", "apps/desktop/host", "apps/desktop/dist"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./apps/web/src/*"],
      "#app/*": ["./apps/desktop/src/*"],
      "@loora/platform": ["./packages/platform/src/runtime.ts"],
      "@loora/platform/*": ["./packages/platform/src/*"],
      "@loora/shell/lib/*": ["./packages/shell/src/lib/*.ts"],
      "@loora/shell/admin/*": ["./packages/shell/src/components/admin/*.tsx"],
      "@loora/shell/*": ["./packages/shell/src/components/*.tsx"],
      "@/*": ["./apps/web/src/*"],
      "@loora/db": ["./packages/db/src/index.ts"],
      "@loora/db/*": ["./packages/db/src/*"],
      "@loora/auth": ["./packages/auth/src/auth.ts"],
      "@loora/auth/*": ["./packages/auth/src/*"],
      "@loora/email": ["./packages/email/src/index.ts"],
      "@loora/email/*": ["./packages/email/src/*"],
      "@loora/canvas": ["./packages/canvas/src/index.ts"],
      "@loora/canvas/*": ["./packages/canvas/src/*"],
      "@loora/agent/*": ["./packages/agent/src/*"],
      "@loora/realtime/*": ["./packages/realtime/src/*"],
      "@loora/rpc": ["./packages/rpc/src/router.ts"],
      "@loora/rpc/*": ["./packages/rpc/src/*"],
      "@loora/editor/lib/canvas-capture": [
        "./packages/editor/src/lib/canvas-capture.tsx"
      ],
      "@loora/editor/lib/*": ["./packages/editor/src/lib/*.ts"],
      "@loora/editor/*": ["./packages/editor/src/components/*.tsx"],
      "@loora/ui/utils": ["./packages/ui/src/lib/utils.ts"],
      "@loora/ui/icons": ["./packages/ui/src/icons/index.tsx"],
      "@loora/ui/hooks/*": ["./packages/ui/src/hooks/*.ts"],
      "@loora/ui/*": ["./packages/ui/src/components/*.tsx"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
