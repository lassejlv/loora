{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run vite dev --port 3000",
    "build": "bun --env-file=../../.env run vite build && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build:railway": "bun --env-file=../../.env run vite build --config vite.config.railway.ts",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false --include-runtime false",
    "start:railway": "bun --env-file=../../.env run .output/server/index.mjs",
    "benchmark-api": "bun --env-file=../../.env run scripts/benchmark-api.ts",
    "indexnow": "bun run scripts/indexnow.ts",
    "test": "bun run --cwd ../.. test apps/web",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.20",
    "@cloudflare/puppeteer": "^1.4.0",
    "@databuddy/sdk": "^2.6.0",
    "@loora/agent": "workspace:*",
    "@loora/assistant": "workspace:*",
    "@loora/auth": "workspace:*",
    "@loora/billing": "workspace:*",
    "@loora/canvas": "workspace:*",
    "@loora/db": "workspace:*",
    "@loora/editor": "workspace:*",
    "@loora/platform": "workspace:*",
    "@loora/railway": "workspace:*",
    "@loora/realtime": "workspace:*",
    "@loora/rpc": "workspace:*",
    "@loora/shell": "workspace:*",
    "@loora/ui": "workspace:*",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-core": "1.171.27",
    "@tanstack/router-plugin": "^1.168.22",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "ai": "^7.0.51",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "nitro": "^3.0.260610-beta",
    "nuqs": "^2.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^28.1.0",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "wrangler": "^4.129.0"
  }
}
