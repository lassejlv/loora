{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/ws/Dockerfile",
    "watchPatterns": [
      "apps/ws/**",
      "packages/realtime/**",
      "package.json",
      "bun.lock",
      "bunfig.toml",
      "apps/ws/Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "sleepApplication": false,
    "healthcheckPath": "/health"
  }
}
