DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_SECONDS=5
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Shared by the web and MCP Railway services for Canvas event invalidation.
REDIS_URL=redis://default:password@host:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
REQUIRE_PREVIEW_ACCESS=true
REQUIRE_POLAR_BILLING=false
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_FREE_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
# Polar models monthly and yearly billing as separate products.
POLAR_PRO_YEARLY_PRODUCT_ID=
# Optional legacy product ID so existing Studio subscribers keep access.
POLAR_STUDIO_PRODUCT_ID=
POLAR_MCP_METER_ID=
POLAR_ACCESS_BENEFIT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_DATA_ENCRYPTION_KEY=
MCP_SCREENSHOT_CONCURRENCY=2
MCP_SCREENSHOT_QUEUE_LIMIT=8
MCP_SCREENSHOT_QUEUE_TIMEOUT_MS=20000
# Local authenticated API benchmark. Keep credential values out of commits.
LOORA_BENCHMARK_TARGET=canvas
LOORA_BENCHMARK_BASE_URL=http://localhost:3000
LOORA_BENCHMARK_DESIGN_ID=
LOORA_BENCHMARK_DRAFT_ID=
LOORA_BENCHMARK_SESSION_COOKIE=
LOORA_BENCHMARK_MCP_TOKEN=
LOORA_BENCHMARK_ITERATIONS=50
LOORA_BENCHMARK_CONCURRENCY=1
