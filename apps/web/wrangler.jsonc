{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loora-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "vars": {
    "REALTIME_WS_URL": "wss://ws.loora.design",
    "REALTIME_INGEST_URL": "https://ws.loora.design"
  },
  "routes": [
    {
      "pattern": "loora.design/*",
      "zone_name": "loora.design"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "loora",
      "preview_bucket_name": "loora-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
