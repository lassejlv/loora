DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_SECONDS=5
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Realtime bus. Set on the ws service (and on web while the SSE fallback is
# in use); without it the ws service keeps rooms in memory as a single instance.
REDIS_URL=redis://default:password@host:6379
# Realtime WebSocket service (apps/ws).
# Browser-facing URL the web app hands out with each connection ticket.
REALTIME_WS_URL=ws://localhost:4200
# Internal URL web/MCP publish events to. Unset falls back to Redis publishing.
REALTIME_INGEST_URL=http://localhost:4200
# Signs connection tickets on web, verifies them on ws. >= 32 characters.
REALTIME_TICKET_SECRET=replace-with-at-least-32-random-characters
# Optional, ws only: the key being retired during a rotation. Still verifies
# until the tickets it signed have expired, which takes a minute.
REALTIME_TICKET_SECRET_PREVIOUS=
# Guards the ws service's /publish and /state endpoints. >= 32 characters.
REALTIME_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# Optional comma-separated browser origins allowed to open a socket.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
REQUIRE_PREVIEW_ACCESS=true
REQUIRE_POLAR_BILLING=false
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_FREE_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
# Polar models monthly and yearly billing as separate products.
POLAR_PRO_YEARLY_PRODUCT_ID=
# Optional legacy product ID so existing Studio subscribers keep access.
POLAR_STUDIO_PRODUCT_ID=
POLAR_MCP_METER_ID=
POLAR_ACCESS_BENEFIT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Email Sending. The token only needs Email Sending permission.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM="Loora <hello@loora.design>"
EMAIL_REPLY_TO=support@loora.design
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_DATA_ENCRYPTION_KEY=
# Asset bucket (Cloudflare R2 or any S3-compatible store). Without these,
# uploads fall back to base64 rows in the asset table.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
# Public bucket domain. Set it and image nodes point straight at the object
# instead of the authenticated /api/asset route. Objects served from it are
# readable by anyone holding the URL, and it needs CORS (Access-Control-Allow-
# Origin) for the app origin so PNG export can inline the bytes.
S3_PUBLIC_URL=
MCP_SCREENSHOT_CONCURRENCY=1
MCP_SCREENSHOT_QUEUE_LIMIT=2
MCP_SCREENSHOT_QUEUE_TIMEOUT_MS=20000
MCP_SCREENSHOT_IDLE_TIMEOUT_MS=60000
MCP_AUTH_TIMEOUT_MS=5000
# Opt-in JSON request timing logs for web/MCP (`api.request` console.info lines).
LOG_REQUEST_TIMING=false
# Local authenticated API benchmark. Keep credential values out of commits.
LOORA_BENCHMARK_TARGET=canvas
LOORA_BENCHMARK_BASE_URL=http://localhost:3000
LOORA_BENCHMARK_DESIGN_ID=
LOORA_BENCHMARK_DRAFT_ID=
LOORA_BENCHMARK_SESSION_COOKIE=
LOORA_BENCHMARK_MCP_TOKEN=
LOORA_BENCHMARK_ITERATIONS=50
LOORA_BENCHMARK_CONCURRENCY=1
