{
  "name": "loora",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "chromium-bidi": "14.0.0",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.61.1",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "4.1.6"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:ws": "cargo run -p loora-ws-server",
    "dev:mcp": "cargo run -p loora-mcp-server",
    "dev:mcp:stdio": "cargo run -p loora-mcp-server -- --stdio",
    "build": "bun run --cwd apps/web build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "check:desktop": "bun run --cwd apps/desktop check",
    "benchmark-api": "bun run --cwd apps/web benchmark-api",
    "seo:indexnow": "bun run --cwd apps/web indexnow",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "preview": "bun run --cwd apps/web preview",
    "start": "bun run --cwd apps/web start",
    "test": "vitest run",
    "generate-routes": "bun run --cwd apps/web generate-routes",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio",
    "canvas:repair-layout": "bun run --cwd packages/rpc repair-layout",
    "assets:backfill-urls": "bun run --cwd packages/rpc backfill-asset-urls",
    "mcp:tools": "bun run --cwd packages/rpc dump-mcp-tools",
    "polar:provision": "bun run --cwd packages/billing polar:provision"
  },
  "trustedDependencies": ["esbuild", "lightningcss"],
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "better-auth": "^1.6.23",
      "drizzle-orm": "^0.45.2",
      "zod": "^4.4.3",
      "@polar-sh/sdk": "0.49.0",
      "typescript": "^6.0.3"
    }
  }
}
