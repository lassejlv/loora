{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "package.json",
      "bun.lock",
      "bunfig.toml",
      "Dockerfile",
      ".dockerignore",
      "tsconfig.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 10,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "sleepApplication": false
  }
}
