{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "src/**",
      "public/**",
      "drizzle/**",
      "package.json",
      "bun.lock",
      "Dockerfile",
      ".dockerignore",
      "vite.config.ts",
      "tsconfig.json",
      "drizzle.config.ts",
      "railway.json"
    ]
  },
  "deploy": {
    "sleepApplication": true,
    "limitOverride": {
      "containers": {
        "cpu": 2,
        "memoryBytes": 4294967296
      }
    }
  }
}
