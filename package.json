{
  "name": "loora",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "ai": "^7.0.31",
      "better-auth": "^1.6.23",
      "drizzle-orm": "^0.45.2",
      "zod": "^4.4.3",
      "@polar-sh/sdk": "0.49.0",
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "preview": "bun run --cwd apps/web preview",
    "start": "bun run --cwd apps/web start",
    "test": "bun test --preload ./apps/web/src/test/setup.ts",
    "generate-routes": "bun run --cwd apps/web generate-routes",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio",
    "canvas:repair-layout": "bun run --cwd packages/rpc repair-layout",
    "polar:provision": "bun run --cwd packages/billing polar:provision"
  },
  "trustedDependencies": ["esbuild", "lightningcss"],
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@opencode-ai/cli": "^0.0.0-next-15919"
  }
}
