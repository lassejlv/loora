{
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./apps/web/src/*"],
      "@/*": ["./apps/web/src/*"],
      "@loora/db": ["./packages/db/src/index.ts"],
      "@loora/db/*": ["./packages/db/src/*"],
      "@loora/auth": ["./packages/auth/src/auth.ts"],
      "@loora/auth/*": ["./packages/auth/src/*"],
      "@loora/canvas": ["./packages/canvas/src/index.ts"],
      "@loora/canvas/*": ["./packages/canvas/src/*"],
      "@loora/agent/*": ["./packages/agent/src/*"],
      "@loora/realtime/*": ["./packages/realtime/src/*"],
      "@loora/rpc": ["./packages/rpc/src/router.ts"],
      "@loora/rpc/*": ["./packages/rpc/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
